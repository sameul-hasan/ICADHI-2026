rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /qrcodes/{allPaths=**} {
      // Allow public read access so email client engines can embed and display QR codes in HTML emails
      allow read: if true;
      
      // Allow write access only to authenticated administrators
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
